# Compute precision jumps manually using logarithmic error metrics
# D_t = -log10(|x_t - x*|)
def get_digits(x_val):
    error = abs(x_val - root_truth)
    if error == 0: return 600.0
    return -float(gmpy2.log10(error))

# ---- Simulation of the Step Jumps ----
d0 = get_digits(x0) # Starting accuracy ~ 4.9 digits
